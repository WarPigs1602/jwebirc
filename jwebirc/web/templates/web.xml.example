<!-- ============================================
     jWebIRC Template System Configuration
     Example configuration for web.xml
     ============================================ -->

<!-- Template System: Enable/Disable -->
<!-- Set to 'true' to enable the template system, 'false' to use default styling only -->
<context-param>
    <param-name>jwebirc.templateEnabled</param-name>
    <param-value>true</param-value>
</context-param>

<!-- Template System: Default Template -->
<!-- Specify which template should be loaded by default -->
<!-- Must match a directory name in web/templates/ -->
<context-param>
    <param-name>jwebirc.templateDefault</param-name>
    <param-value>dark-theme</param-value>
</context-param>

<!-- Template System: User Selectable -->
<!-- Allow users to switch templates via the UI -->
<!-- Set to 'false' to enforce a single template for all users -->
<context-param>
    <param-name>jwebirc.templateUserSelectable</param-name>
    <param-value>true</param-value>
</context-param>

<!-- Template System: Available Templates -->
<!-- Comma-separated list of template directory names -->
<!-- Each template must have a corresponding directory in web/templates/ with a style.css file -->
<context-param>
    <param-name>jwebirc.templateAvailable</param-name>
    <param-value>dark-theme,light-theme</param-value>
</context-param>

<!-- Template System: Template Path -->
<!-- Base path for template directories (relative to web root) -->
<!-- Default: 'templates/' - only change if you move the templates directory -->
<context-param>
    <param-name>jwebirc.templatePath</param-name>
    <param-value>templates/</param-value>
</context-param>

<!-- 
    TEMPLATE SYSTEM USAGE EXAMPLES:
    
    1. Force dark theme for all users:
       - templateEnabled: true
       - templateDefault: dark-theme
       - templateUserSelectable: false
       
    2. Allow users to choose between themes:
       - templateEnabled: true
       - templateDefault: dark-theme
       - templateUserSelectable: true
       - templateAvailable: dark-theme,light-theme
       
    3. Disable template system (use base style.css only):
       - templateEnabled: false
       
    4. Use custom theme only:
       - templateEnabled: true
       - templateDefault: my-custom-theme
       - templateUserSelectable: false
       - templateAvailable: my-custom-theme
-->
